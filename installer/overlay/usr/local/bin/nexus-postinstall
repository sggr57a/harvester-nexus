#!/usr/bin/env bash
# nexus-postinstall — invoked from the Harvester install wizard's
# `post_install` hook AFTER the operator has answered every install
# question. Writes wizard answers into /etc/nexus/config.yaml so the
# first-boot bootstrap picks them up.

set -euo pipefail

CONFIG_FILE=/etc/nexus/config.yaml
ANSWERS_FILE=${1:-/etc/nexus/wizard-answers.yaml}

if [[ ! -f "${ANSWERS_FILE}" ]]; then
  printf '[nexus-postinstall] no wizard answers found at %s, using built-in defaults\n' "${ANSWERS_FILE}" >&2
  exit 0
fi

printf '[nexus-postinstall] merging wizard answers from %s into %s\n' "${ANSWERS_FILE}" "${CONFIG_FILE}"

# Merge YAML files with yq (built into the iso-builder image). For the
# fields that the wizard exposes the answer file just contains a flat
# top-level override; the merge is a deep one.
if command -v yq >/dev/null 2>&1; then
  TMP=$(mktemp)
  yq eval-all '. as $item ireduce ({}; . * $item)' "${CONFIG_FILE}" "${ANSWERS_FILE}" > "${TMP}"
  mv "${TMP}" "${CONFIG_FILE}"
else
  # Crude fallback: append the answers so the bootstrap parser picks the
  # last definition wins.
  printf '\n# --- wizard answers (post-install) ---\n' >> "${CONFIG_FILE}"
  cat "${ANSWERS_FILE}" >> "${CONFIG_FILE}"
fi

printf '[nexus-postinstall] config merged; first-boot bootstrap will apply it\n'

# Enable the bootstrap + cockpit units so they fire on next boot.
systemctl enable nexus-bootstrap.service
systemctl enable nexus-cockpit.service
printf '[nexus-postinstall] enabled nexus-bootstrap + nexus-cockpit units\n'
