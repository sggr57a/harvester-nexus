#!/usr/bin/env bash
# nexus-cockpit — wraps an nginx serving the cockpit's static
# production bundle from /usr/local/share/nexus-cockpit/. The cockpit
# is also deployed as a Kubernetes Deployment for HA, but THIS
# locally-served copy is what the operator hits on first boot before
# the k8s ingress is fully reconciled. After bootstrap completes, the
# ingress takes over.

set -euo pipefail

ACTION=${1:-help}
shift || true

COCKPIT_ROOT=/usr/local/share/nexus-cockpit
CONFIG_FILE=/etc/nexus/config.yaml
LOG_DIR=/var/log/nexus
HTTPS_PORT=8443
HTTP_PORT=8080
TLS_DIR=/etc/nexus/tls
TLS_CRT=${TLS_DIR}/cockpit.crt
TLS_KEY=${TLS_DIR}/cockpit.key

ensure_tls() {
  mkdir -p "${TLS_DIR}"
  if [[ -f "${TLS_CRT}" && -f "${TLS_KEY}" ]]; then
    return 0
  fi
  if ! command -v openssl >/dev/null 2>&1; then
    printf 'openssl not found; HTTPS will be unavailable\n' >&2
    return 1
  fi
  openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
    -keyout "${TLS_KEY}" -out "${TLS_CRT}" \
    -subj "/CN=nexus-cockpit/O=Harvester-Nexus" >/dev/null 2>&1
  chmod 0644 "${TLS_CRT}"
  chmod 0600 "${TLS_KEY}"
}

case "${ACTION}" in
  --ensure-tls)
    ensure_tls && printf 'TLS material ready under %s\n' "${TLS_DIR}"
    exit $?
    ;;

  --check-config)
    CFG=${1:-${CONFIG_FILE}}
    if [[ ! -f "${CFG}" ]]; then
      printf 'config file not found: %s\n' "${CFG}" >&2
      exit 1
    fi
    if [[ ! -d "${COCKPIT_ROOT}/dist" ]]; then
      printf 'cockpit static bundle missing: %s/dist\n' "${COCKPIT_ROOT}" >&2
      exit 1
    fi
    printf 'config OK: %s\n' "${CFG}"
    printf 'static bundle OK: %s/dist (%d files)\n' "${COCKPIT_ROOT}" "$(find "${COCKPIT_ROOT}/dist" -type f | wc -l)"
    exit 0
    ;;

  --serve)
    mkdir -p "${LOG_DIR}"
    log() { printf '[%s] %s\n' "$(date -Iseconds)" "$*" | tee -a "${LOG_DIR}/cockpit.log"; }

    HAS_TLS=false
    if ensure_tls; then HAS_TLS=true; fi

    if [[ "${HAS_TLS}" == true ]]; then
      log "nexus-cockpit starting on https://0.0.0.0:${HTTPS_PORT} (static root ${COCKPIT_ROOT}/dist)"
    else
      log "nexus-cockpit starting on http://0.0.0.0:${HTTP_PORT} (no TLS material; static root ${COCKPIT_ROOT}/dist)"
    fi

    # systemd-notify so the service is treated as ready
    systemd-notify --ready --status="serving cockpit" 2>/dev/null || true

    # If nginx is present, generate a temp config and exec into it.
    if command -v nginx >/dev/null 2>&1; then
      TMP_CONF=$(mktemp /tmp/nexus-cockpit.XXXXXX.conf)
      if [[ "${HAS_TLS}" == true ]]; then
        cat > "${TMP_CONF}" <<NGX
worker_processes auto;
events { worker_connections 1024; }
http {
  include       mime.types;
  default_type  application/octet-stream;
  sendfile      on;
  gzip          on;
  server {
    listen ${HTTPS_PORT} ssl http2;
    listen ${HTTP_PORT};
    server_name _;
    ssl_certificate     ${TLS_CRT};
    ssl_certificate_key ${TLS_KEY};
    root ${COCKPIT_ROOT}/dist;
    index index.html;
    location /healthz { return 200 'ok'; add_header Content-Type text/plain; }
    location / { try_files \$uri \$uri/ /index.html; }
  }
}
NGX
      else
        cat > "${TMP_CONF}" <<NGX
worker_processes auto;
events { worker_connections 1024; }
http {
  include       mime.types;
  default_type  application/octet-stream;
  sendfile      on;
  gzip          on;
  server {
    listen ${HTTP_PORT};
    server_name _;
    root ${COCKPIT_ROOT}/dist;
    index index.html;
    location /healthz { return 200 'ok'; add_header Content-Type text/plain; }
    location / { try_files \$uri \$uri/ /index.html; }
  }
}
NGX
      fi
      exec nginx -c "${TMP_CONF}" -g 'daemon off;'
    fi

    # Fallback: use python's built-in HTTP server (works during early boot
    # before nginx is installed). Only HTTP — TLS is added by nginx later.
    if command -v python3 >/dev/null 2>&1; then
      cd "${COCKPIT_ROOT}/dist"
      exec python3 -m http.server "${HTTP_PORT}" --bind 0.0.0.0
    fi

    printf 'no nginx or python3 available; cannot serve cockpit\n' >&2
    exit 1
    ;;

  help|--help|-h)
    cat <<USAGE
nexus-cockpit — Harvester-Nexus cockpit launcher

Usage:
  nexus-cockpit --check-config [<path>]
      Verify config file + static bundle are present.

  nexus-cockpit --serve --config <path>
      Serve the cockpit (nginx if present, else python http.server).

  nexus-cockpit help
      Show this message.

Paths:
  static bundle:   ${COCKPIT_ROOT}/dist
  config:          ${CONFIG_FILE}
  log:             ${LOG_DIR}/cockpit.log
USAGE
    ;;

  *)
    printf 'unknown action: %s (try --help)\n' "${ACTION}" >&2
    exit 2
    ;;
esac
