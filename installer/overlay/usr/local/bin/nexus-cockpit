#!/usr/bin/env bash
# nexus-cockpit — serves the cockpit production bundle from
# /usr/local/share/nexus-cockpit/dist on each node (nginx, python3, or busybox).

set -euo pipefail

ACTION=${1:-help}
shift || true

COCKPIT_ROOT=/usr/local/share/nexus-cockpit
CONFIG_FILE=/etc/nexus/config.yaml
LOG_DIR=/var/log/nexus
HTTPS_PORT=8443
HTTP_PORT=8080
TLS_DIR=/etc/nexus/tls
TLS_CRT=${TLS_DIR}/cockpit.crt
TLS_KEY=${TLS_DIR}/cockpit.key

ensure_tls() {
  mkdir -p "${TLS_DIR}"
  if [[ -f "${TLS_CRT}" && -f "${TLS_KEY}" ]]; then
    return 0
  fi
  if ! command -v openssl >/dev/null 2>&1; then
    printf 'openssl not found; serving HTTP only on port %s\n' "${HTTP_PORT}" >&2
    return 1
  fi
  openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
    -keyout "${TLS_KEY}" -out "${TLS_CRT}" \
    -subj "/CN=nexus-cockpit/O=Harvester-Nexus" >/dev/null 2>&1
  chmod 0644 "${TLS_CRT}"
  chmod 0600 "${TLS_KEY}"
}

nginx_mime_block() {
  cat <<'MIME'
    types {
      text/html                             html htm;
      text/css                              css;
      application/javascript                js mjs;
      application/json                      json map;
      image/png                             png;
      image/jpeg                            jpg jpeg;
      image/svg+xml                         svg svgz;
      image/webp                            webp;
      image/x-icon                          ico;
      font/woff                             woff;
      font/woff2                            woff2;
      application/octet-stream              bin;
    }
    default_type application/octet-stream;
MIME
}

write_nginx_config() {
  local conf=$1 has_tls=$2
  cat > "${conf}" <<NGX
worker_processes auto;
pid /run/nexus-cockpit-nginx.pid;
error_log ${LOG_DIR}/nginx-error.log warn;
events { worker_connections 1024; }
http {
  sendfile on;
  gzip on;
$(nginx_mime_block)
  server {
NGX
  if [[ "${has_tls}" == true ]]; then
    cat >> "${conf}" <<NGX
    listen ${HTTPS_PORT} ssl;
    listen ${HTTP_PORT};
    ssl_certificate     ${TLS_CRT};
    ssl_certificate_key ${TLS_KEY};
NGX
  else
    cat >> "${conf}" <<NGX
    listen ${HTTP_PORT};
NGX
  fi
  cat >> "${conf}" <<NGX
    server_name _;
    root ${COCKPIT_ROOT}/dist;
    index index.html;
    location /healthz { return 200 'ok'; add_header Content-Type text/plain; }
    location / { try_files \$uri \$uri/ /index.html; }
  }
}
NGX
}

start_busybox_httpd() {
  local port=$1
  if ! command -v busybox >/dev/null 2>&1; then
    return 1
  fi
  if ! busybox httpd -h 2>&1 | grep -q httpd; then
    return 1
  fi
  exec busybox httpd -f -v -p "${port}" -h "${COCKPIT_ROOT}/dist"
}

case "${ACTION}" in
  --ensure-tls)
    if ensure_tls; then
      printf 'TLS material ready under %s\n' "${TLS_DIR}"
    else
      printf 'TLS not configured; cockpit will serve HTTP on port %s\n' "${HTTP_PORT}" >&2
    fi
    exit 0
    ;;

  --check-config)
    CFG=${1:-${CONFIG_FILE}}
    if [[ ! -f "${CFG}" ]]; then
      printf 'config file not found: %s\n' "${CFG}" >&2
      exit 1
    fi
    if [[ ! -f "${COCKPIT_ROOT}/dist/index.html" ]]; then
      printf 'cockpit static bundle missing: %s/dist/index.html\n' "${COCKPIT_ROOT}" >&2
      exit 1
    fi
    printf 'config OK: %s\n' "${CFG}"
    printf 'static bundle OK: %s/dist (%d files)\n' "${COCKPIT_ROOT}" "$(find "${COCKPIT_ROOT}/dist" -type f | wc -l)"
    exit 0
    ;;

  --serve)
    mkdir -p "${LOG_DIR}" /run
    log() { printf '[%s] %s\n' "$(date -Iseconds)" "$*" | tee -a "${LOG_DIR}/cockpit.log"; }

    HAS_TLS=false
    if ensure_tls; then HAS_TLS=true; fi

    if [[ "${HAS_TLS}" == true ]]; then
      log "starting cockpit on https://0.0.0.0:${HTTPS_PORT} and http://0.0.0.0:${HTTP_PORT}"
    else
      log "starting cockpit on http://0.0.0.0:${HTTP_PORT} (TLS unavailable)"
    fi

    if command -v nginx >/dev/null 2>&1; then
      TMP_CONF=$(mktemp /tmp/nexus-cockpit.XXXXXX.conf)
      write_nginx_config "${TMP_CONF}" "${HAS_TLS}"
      exec nginx -c "${TMP_CONF}" -g 'daemon off;'
    fi

    if command -v python3 >/dev/null 2>&1; then
      cd "${COCKPIT_ROOT}/dist"
      exec python3 -m http.server "${HTTP_PORT}" --bind 0.0.0.0
    fi

    start_busybox_httpd "${HTTP_PORT}"

    printf 'no nginx, python3, or busybox httpd available; cannot serve cockpit\n' >&2
    exit 1
    ;;

  help|--help|-h)
    cat <<USAGE
nexus-cockpit — Harvester-Nexus cockpit launcher

Usage:
  nexus-cockpit --check-config [<path>]
  nexus-cockpit --ensure-tls
  nexus-cockpit --serve [--config <path>]
  nexus-cockpit help
USAGE
    ;;

  *)
    printf 'unknown action: %s (try --help)\n' "${ACTION}" >&2
    exit 2
    ;;
esac
